---
import Layout from "../layouts/Layout.astro";

const features = [
  {
    icon: "Phases",
    title: "Game phase state machine",
    body: "Lobby → countdown → grace → combat → ending. Clean transitions, no stuck rounds.",
  },
  {
    icon: "Arenas",
    title: "Config-driven arenas",
    body: "Define arenas, spawn points, and feast locations from YAML. No hardcoded maps.",
  },
  {
    icon: "Loot",
    title: "Tiered chest loot",
    body: "Three loot tiers across the map. Push for better gear, risk PvP at the feast.",
  },
  {
    icon: "Grace",
    title: "Configurable grace period",
    body: "60s default — tune it from config. PvP unlocks once everyone is geared.",
  },
  {
    icon: "Spectate",
    title: "Spectator mode",
    body: "Eliminated players spectate the rest of the round instead of getting kicked.",
  },
  {
    icon: "Stats",
    title: "Persistent stats",
    body: "SQLite for the MVP, Postgres later. Wins, kills, K/D — tracked per player.",
  },
];

const kits = [
  {
    cls: "kit-tank",
    name: "Tank",
    desc: "Iron chestplate and a shield. Soak hits, hold ground at the feast.",
  },
  {
    cls: "kit-archer",
    name: "Archer",
    desc: "Bow, arrows, leather armor. Pick fights from range and reposition fast.",
  },
  {
    cls: "kit-assassin",
    name: "Assassin",
    desc: "Iron sword, speed potion. Burst damage, hit-and-run, no second chances.",
  },
  {
    cls: "kit-survivor",
    name: "Survivor",
    desc: "Food, golden apples, bandages. Outlast the others — last one alive wins.",
  },
];

const commands = [
  { cmd: "/kit", desc: "Pick a starter kit before the round begins." },
  { cmd: "/kit <name>", desc: "Select a specific kit by name." },
  { cmd: "/arena create <name>", desc: "Admin — create a new arena." },
  { cmd: "/arena addspawn <name>", desc: "Admin — register a spawn point." },
  { cmd: "/arena info <name>", desc: "Admin — inspect an arena's config." },
  { cmd: "/arena list", desc: "Admin — list all loaded arenas." },
  { cmd: "/hg start", desc: "Admin — force-start the next round." },
  { cmd: "/hg reset", desc: "Admin — reset the current match." },
];
---

<Layout>
  <nav class="nav">
    <div class="nav-inner">
      <div class="brand">Peytz<span class="accent">PvP</span></div>
      <div class="nav-links">
        <a href="#features">Features</a>
        <a href="#kits">Kits</a>
        <a href="#commands">Commands</a>
        <a href="#play">Play</a>
      </div>
    </div>
  </nav>

  <main class="deck" id="deck">
  <header class="hero slide" id="home">
    <div class="container">
      <span class="tag">// Paper 1.21 · Java 21</span>
      <h1>Hardcore Games. Old-school PvP.</h1>
      <p class="lede">
        PeytzPvP is a modern Hardcore Games plugin inspired by the survival-games servers
        you grew up on. Drop into the arena, scavenge tiered chests, survive the grace
        period — last player standing wins.
      </p>

      <div class="connect">
        <div class="connect-row">
          <span class="connect-label">Server</span>
          <button
            class="connect-addr"
            type="button"
            data-copy="play.peytzpvp.com"
            aria-label="Copy server address"
          >
            play.peytzpvp.com
          </button>
        </div>
        <div class="connect-row">
          <span class="connect-label">Version</span>
          <span class="connect-version">Minecraft Java 1.21</span>
        </div>
      </div>

      <div class="btn-row">
        <a class="btn" href="#play">How to play</a>
        <a class="btn secondary" href="https://github.com/WPeytz/PeytzPvP" target="_blank" rel="noopener"
          >View on GitHub</a
        >
      </div>

      <script is:inline>
        document.addEventListener("click", (e) => {
          const t = e.target;
          if (!(t instanceof HTMLElement)) return;
          const btn = t.closest("[data-copy]");
          if (!btn) return;
          const value = btn.getAttribute("data-copy");
          if (!value) return;
          navigator.clipboard?.writeText(value);
          const original = btn.textContent;
          btn.textContent = "copied!";
          btn.classList.add("copied");
          setTimeout(() => {
            btn.textContent = original;
            btn.classList.remove("copied");
          }, 1200);
        });
      </script>
    </div>
  </header>

  <section id="features" class="slide">
    <div class="container">
      <div class="eyebrow">// FEATURES</div>
      <h2>What's in the box</h2>
      <p style="color:var(--muted); margin-top:0; max-width:680px;">
        A clean, config-driven core. No god classes, no reflection, no NMS — just a
        small set of services doing one thing each.
      </p>
      <div class="grid" style="margin-top:2rem;">
        {
          features.map((f) => (
            <article class="card">
              <div class="icon">[{f.icon}]</div>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="kits" class="kits slide">
    <div class="container">
      <div class="eyebrow">// LOADOUTS</div>
      <h2>Four starter kits</h2>
      <p style="color:var(--muted); margin-top:0;">
        Pick before the countdown ends. Every kit changes how you play the round.
      </p>
      <div class="grid" style="margin-top:2rem;">
        {
          kits.map((k) => (
            <article class={`card ${k.cls}`}>
              <h3>{k.name}</h3>
              <p>{k.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="commands" class="slide">
    <div class="container">
      <div class="eyebrow">// COMMANDS</div>
      <h2>Commands</h2>
      <ul class="cmd-list" style="margin-top:1.5rem;">
        {
          commands.map((c) => (
            <li>
              <code>{c.cmd}</code>
              <span class="desc">{c.desc}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="play" class="slide">
    <div class="container">
      <div class="eyebrow">// HOW TO PLAY</div>
      <h2>Jump into a round</h2>
      <div class="grid" style="margin-top:2rem;">
        <article class="card">
          <div class="icon">[01]</div>
          <h3>Connect</h3>
          <p>
            Java Edition 1.21 → add server <code style="color:var(--accent);">play.peytzpvp.com</code>.
            You'll spawn in the lobby; the round starts once {`{min: 2}`} players are in.
          </p>
        </article>
        <article class="card">
          <div class="icon">[02]</div>
          <h3>Pick a kit</h3>
          <p>Run <code style="color:var(--accent);">/kit</code> and choose your loadout before the round begins.</p>
        </article>
        <article class="card">
          <div class="icon">[03]</div>
          <h3>Loot &amp; survive</h3>
          <p>
            60 seconds of grace period. Scavenge tiered chests, then PvP unlocks and
            the feast spawns.
          </p>
        </article>
        <article class="card">
          <div class="icon">[04]</div>
          <h3>Last one alive</h3>
          <p>Eliminations send you to spectator. Win the round, climb the leaderboard.</p>
        </article>
      </div>
    </div>
  </section>
  </main>

  <div class="deck-controls">
    <button class="deck-btn" id="prevBtn" type="button" aria-label="Previous">‹ Prev</button>
    <div class="dots" id="dots" role="tablist" aria-label="Sections"></div>
    <button class="deck-btn" id="nextBtn" type="button" aria-label="Next">Next ›</button>
  </div>

  <footer class="deck-footer">
    Not affiliated with Mojang or Microsoft. © {new Date().getFullYear()} PeytzPvP
  </footer>

  <script is:inline>
    (function () {
      const deck = document.getElementById("deck");
      const slides = Array.from(deck.querySelectorAll(".slide"));
      const prevBtn = document.getElementById("prevBtn");
      const nextBtn = document.getElementById("nextBtn");
      const dotsWrap = document.getElementById("dots");
      const labels = ["Home", "Features", "Kits", "Commands", "Play"];
      let i = 0;

      // When embedded (PeytzGames play page), let the host size the iframe to
      // the active slide so there's no nested scrollbar. Pin body height to
      // content first, otherwise min-height:100vh would track the iframe and
      // the reported height would ratchet upward.
      const embedded = window.self !== window.top;
      if (embedded) {
        const s = document.createElement("style");
        s.textContent =
          "html,body{min-height:0!important;height:auto!important;}";
        document.head.appendChild(s);
      }
      let raf = 0;
      function reportHeight() {
        if (!embedded) return;
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          parent.postMessage(
            {
              type: "embed:height",
              height: document.documentElement.scrollHeight,
            },
            "*",
          );
        });
      }

      const dots = slides.map((_, idx) => {
        const d = document.createElement("button");
        d.type = "button";
        d.className = "dot";
        d.setAttribute("aria-label", labels[idx] || "Slide " + (idx + 1));
        d.addEventListener("click", () => go(idx));
        dotsWrap.appendChild(d);
        return d;
      });

      function go(n) {
        i = Math.max(0, Math.min(slides.length - 1, n));
        slides.forEach((s, idx) => {
          s.classList.toggle("is-active", idx === i);
          if (idx === i) s.scrollTop = 0;
        });
        dots.forEach((d, idx) => d.classList.toggle("is-active", idx === i));
        prevBtn.disabled = i === 0;
        nextBtn.disabled = i === slides.length - 1;
        reportHeight();
      }

      prevBtn.addEventListener("click", () => go(i - 1));
      nextBtn.addEventListener("click", () => go(i + 1));

      // In-page anchors (nav links, "How to play") jump to the matching slide.
      document.querySelectorAll('a[href^="#"]').forEach((a) => {
        a.addEventListener("click", (e) => {
          const id = (a.getAttribute("href") || "").slice(1);
          const idx = slides.findIndex((s) => s.id === id);
          if (idx >= 0) {
            e.preventDefault();
            go(idx);
          }
        });
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight" || e.key === "PageDown") go(i + 1);
        else if (e.key === "ArrowLeft" || e.key === "PageUp") go(i - 1);
      });

      // Deep-link / start on a specific slide via #hash (e.g. /#commands).
      const startId = (location.hash || "").slice(1);
      const startIdx = slides.findIndex((s) => s.id === startId);
      go(startIdx >= 0 ? startIdx : 0);

      // Re-report height after fonts load / on resize (pixel font reflows).
      if (embedded) {
        window.addEventListener("load", reportHeight);
        window.addEventListener("resize", reportHeight);
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(reportHeight);
        }
      }
    })();
  </script>
</Layout>
